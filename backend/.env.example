DATABASE_URL=postgresql://usuario:password@localhost:5432/smartlook_ai
SECRET_KEY=cambia-esto-por-una-clave-segura
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
STRIPE_SECRET_KEY=sk_test_xxx
AI_API_KEY=
# Chatbot (CU21): IA local vía Ollama corriendo en tu máquina (no en Docker).
# Si Ollama no está disponible, el chatbot cae automáticamente al motor de reglas.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:1b
# Subida de imágenes de productos a Supabase Storage. La service_role key tiene
# permisos totales — solo se usa acá en el backend, nunca en el frontend.
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=productos
# Vestidor virtual (CU05): Gemini 2.5 Flash Image ("Nano Banana"), tier gratis de
# Google AI Studio (https://aistudio.google.com/apikey). Sin esta clave, el vestidor
# sigue funcionando con la silueta dibujada en el navegador (MediaPipe).
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# Vestidor virtual móvil (CU05): Replicate (IDM-VTON), pago por uso — presupuesto
# limitado, por eso hay cache de 24h y un límite diario por usuario (ver
# VESTIDOR_MAX_POR_USUARIO_DIA más abajo).
REPLICATE_API_TOKEN=r8_xxx
VESTIDOR_MAX_POR_USUARIO_DIA=5
# Orígenes permitidos por CORS, separados por coma (sin espacios). En producción
# agregar la URL del frontend desplegado, ej: https://smartlook-ai.vercel.app
CORS_ORIGINS=http://localhost:4200
